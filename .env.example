# 推荐运行 python3 scripts/backend-env.py 自动生成随机凭证。
MYSQL_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
S3_ACCESS_KEY=maparmy-local
S3_SECRET_KEY=replace-with-random-storage-password
S3_BUCKET=map-army
DATABASE_URL=mysql+pymysql://map_army:replace-with-random-database-password@127.0.0.1:33080/map_army
S3_ENDPOINT=http://127.0.0.1:39000
COOKIE_SECURE=false
APP_PORT=8080
MYSQL_PORT=33080
S3_PORT=39000
S3_CONSOLE_PORT=39001
LEGACY_SHARE_VOLUME=map_army_share-data
