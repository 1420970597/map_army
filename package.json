{
  "name": "map-army",
  "version": "6.1.2",
  "private": true,
  "type": "module",
  "description": "map.army —— 军事标图 Web 应用开源复刻版：基于 MIL-STD-2525 / STANAG APP-6 军标符号，支持 MGRS / UTM / BNG 军网，可绘制、保存、导出与交换战术态势图（MilX）。",
  "keywords": [
    "military map",
    "common operational picture",
    "COP",
    "MIL-STD-2525",
    "STANAG APP-6",
    "MGRS",
    "UTM",
    "BNG",
    "MilX",
    "tactical map"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "models:build": "blender --background --python-exit-code 1 --python assets/unit-models/build_models.py",
    "models:check": "node assets/unit-models/validate.mjs",
    "dev": "vite",
    "site": "node site/generate.mjs && node site/icons.mjs && node site/cesium.mjs",
    "build": "npm run site && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run format:check && npm run models:check && npm run test && npm run test:server && npm run build",
    "test:server": "node --test server/*.test.mjs",
    "server": "node server/index.mjs",
    "predev": "node site/cesium.mjs"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "geomagnetism": "^0.2.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.1",
    "leaflet": "^1.9.4",
    "milsymbol": "^3.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "three": "^0.186.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
